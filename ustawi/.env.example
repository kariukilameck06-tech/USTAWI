BUSINESS_EMAIL=kariukiondari06@gmail.com
BUSINESS_LOCATION=Imara Daima, Nairobi, Kenya
BUSINESS_HOURS=7-10pm
# Address or "lat,lng" for the map at the bottom of the home page and on the Contact page, e.g. "Moi Avenue, Nairobi" or -1.2921,36.8219
BUSINESS_MAP_QUERY=Imara Daima, Nairobi, Kenya

# true = load the Ustawi price list into the database on first run. After that, edit prices in /admin.
SEED_SAMPLE_PRICES=true

# ---- M-Pesa STK push (Daraja) ----
# You can paste these keys here OR directly in mpesa.config.js. Leave blank to use manual Till payments only.
MPESA_TILL=1747080
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Buy Goods: BusinessShortCode is your store/head-office number, PartyB is the Till.
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TX_TYPE=CustomerBuyGoodsOnline
# Public HTTPS address of this server (your ngrok URL while testing, your domain when live)
PUBLIC_URL=
MPESA_CALLBACK_SECRET=change-me-random-string
